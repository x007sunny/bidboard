generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id          String   @id @default(cuid())
  url         String
  handle      String?
  title       String
  description String   @db.Text
  category    String   @default("Other")
  subcategory String?
  states      String[] @default([])
  logoUrl     String?
  bidCents    Int
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastBidAt   DateTime @default(now())
  uniqueKey   String   @unique
  payments    Payment[]
  foundingMember FoundingMember?

  @@index([bidCents(sort: Desc)])
  @@index([lastBidAt(sort: Desc)])
  @@index([category, subcategory])
}

model Payment {
  id               String    @id @default(cuid())
  listingId        String?
  listing          Listing?  @relation(fields: [listingId], references: [id])
  stripeSessionId  String    @unique
  amountCents      Int
  previousBidCents Int?
  newBidCents      Int
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([listingId])
}

// P0: Stripe webhook idempotency — unique on Stripe event.id (evt_...)
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

// P0: real visitors — one row per browser cookie
model Visitor {
  id          String   @id
  ipHash      String?
  userAgent   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
}

// Admin-managed categories + subcategories for filters and the confirmation page
model Category {
  id            String   @id @default(cuid())
  name          String   @unique
  subcategories String[] @default([])
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
}

// Singleton: row id "founding50" exists only after the Founding 50 is locked.
model FoundingLock {
  id       String   @id
  lockedAt DateTime
}

// Frozen archive of the first 50 unique paid listings, ranked at lock time.
// Snapshot fields never change after insert. listingId is SetNull on delete.
model FoundingMember {
  id            String   @id @default(cuid())
  foundingRank  Int      @unique
  listingId     String?  @unique
  listing       Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  uniqueKey     String
  url           String
  title         String
  description   String   @db.Text
  category      String
  subcategory   String?
  states        String[] @default([])
  logoUrl       String?
  bidCents      Int
  clicks        Int      @default(0)
  lastBidAt     DateTime
  createdAt     DateTime @default(now())

  @@index([foundingRank])
  @@index([category, subcategory])
}
